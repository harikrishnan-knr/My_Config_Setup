# ── History ─────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000

setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
setopt APPEND_HISTORY

# ── Navigation ─────────────────────────────────────────
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS

# ── Completion ─────────────────────────────────────────
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# ── Editing ────────────────────────────────────────────
bindkey -e

# ── Useful aliases ─────────────────────────────────────
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'

# ── PATH ───────────────────────────────────────────────
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# ── Environment ────────────────────────────────────────
export EDITOR='nvim'
export VISUAL="$EDITOR"

# ── Prompt ──────────────────────────────────────────────
autoload -Uz colors && colors
PROMPT='%F{green}%n@%m%f:%F{green}%~%f %# '

# ── Useful functions ───────────────────────────────────
mkcd() {
  mkdir -p "$1" && cd "$1"
}

extract() {
  case "$1" in
    *.tar.gz|*.tgz) tar -xzf "$1" ;;
    *.tar.bz2)      tar -xjf "$1" ;;
    *.tar.xz)       tar -xJf "$1" ;;
    *.zip)          unzip "$1" ;;
    *)              echo "Unsupported archive: $1" ;;
  esac
}
preexec() {
  CMD_START_TIME=$EPOCHREALTIME
}

alias open="xdg-open"

bindkey '^[[3~' delete-char
